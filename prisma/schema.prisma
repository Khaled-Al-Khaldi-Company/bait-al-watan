generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// enum Role removed for SQLite compatibility

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("MEMBER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  projects      Project[] @relation("UserProjects")
  participations ProjectParticipation[]
  transactions  Transaction[]
  chatMessages  ChatMessage[]
  activityLogs  ActivityLog[]
  tasks         Task[]    @relation("AssignedTasks")
}

model Project {
  id            String    @id @default(cuid())
  name          String
  location      String?
  description   String?
  status        String    @default("UNDER_STUDY")
  
  // Financial Details
  totalValue        Float     @default(0)
  reservationFee    Float     @default(0)
  installmentValue  Float     @default(0)
  installmentsCount Int       @default(0)
  reservationCode  String?
  phaseNumber      String?
  neighborhood     String?
  plotArea         Float?
  pricePerMeter    Float?
  reservationType  String?    // INITIAL or OFFICIAL
  bookingAccount   String?    // Account 1 or Account 2
  exchangeRate      Float     @default(3.75)
  startDate         DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]    @relation("UserProjects")
  participations ProjectParticipation[]
  phases        Phase[]
  documents     Document[]
  transactions  Transaction[]
  obligations   Obligation[]
  chatMessages  ChatMessage[]
}

model ProjectParticipation {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  shareAmount Float    @default(0) // المبلغ التعاقدي المقرر للشريك
  percentage  Float?   // النسبة المئوية (للتوافق مع البيانات القديمة)
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Phase {
  id            String    @id @default(cuid())
  projectId     String
  name          String    // Pre-application, Application, Allocation, Post-allocation
  order         Int
  status        String    @default("PENDING")
  
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         Task[]
  documents     Document[]
}

model Document {
  id            String    @id @default(cuid())
  projectId     String
  phaseId       String?
  name          String
  type          String    // Receipt, Form, Map, etc.
  url           String
  version       Int       @default(1)
  isCurrent     Boolean   @default(true)
  tag           String?
  createdAt     DateTime  @default(now())
  
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         Phase?    @relation(fields: [phaseId], references: [id])
}

model Transaction {
  id            String    @id @default(cuid())
  projectId     String
  userId        String
  type          String    @default("AUTHORITY_PAYMENT") // MEMBER_CONTRIBUTION or AUTHORITY_PAYMENT
  amount        Float     // المبلغ الإجمالي المدفوع (شامل العمولات)
  officialAmount Float    @default(0) // المبلغ المعترف به من الهيئة
  date          DateTime
  purpose       String    // Reservation, Installment, Fees, Contribution
  attachmentUrl String?   // رابط سند الإيداع أو الإيصال
  sharedExpense Boolean   @default(false)
  egpRate       Float?    // سعر صرف الجنيه وقت التحويل (اختياري)
  createdAt     DateTime  @default(now())

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
}

model Obligation {
  id          String    @id @default(cuid())
  projectId   String
  type        String    // AUTHORITY_DUE or INTERNAL_COLLECTION
  title       String    // عنوان الطلب (مثلاً: القسط الثاني)
  amount      Float     // المبلغ الإجمالي المطلوب جمعه
  dueDate     DateTime  // موعد الاستحقاق
  status        String    @default("PENDING") // PENDING, PARTIAL, COMPLETED
  createdAt     DateTime  @default(now())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id            String    @id @default(cuid())
  phaseId       String
  title         String
  isCompleted   Boolean   @default(false)
  assignedToId  String?
  
  phase         Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignedTo    User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
}

model ChatMessage {
  id            String    @id @default(cuid())
  projectId     String
  userId        String
  content       String
  fileUrl       String?
  createdAt     DateTime  @default(now())

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  details       String?
  timestamp     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
}
